// #include <dt-bindings/zmk/rgb.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500// 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20// 10

#if defined(NXTKB_CODEX_MICRO)

#include <dt-bindings/nxtkb/codex.h>
#include <behaviors/codex_key.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#endif

#include "behaviors/character_map.dtsi"
#include "behaviors/report.dtsi"

#define MAC 0
#define WIN 1
#define RIG 2
#define LEF 3
#define TRI 4
#define MOUSE 5
#define CODEX 6
#define SPEED_POINTER 0
#define SPEED_SCROLL 1
#define SPEED_PREV 0
#define SPEED_NEXT 1
#define SPEED_RESET 2
#define SPEED_FINE_PREV 3
#define SPEED_FINE_NEXT 4
#define CIRQUE_MODE_RELATIVE 0
#define CIRQUE_MODE_ABSOLUTE 1
#define CIRQUE_MODE_TOGGLE 2

&sensors {
    left_encoder { triggers-per-rotation = <15>; };

    right_encoder { triggers-per-rotation = <45>; };
};

&glidepoint_listener { input-processors = <&pointer_processor 0 0 &drag_scroll_processor 1 8>; };

/ {
    pointer_processor: pointer_processor {
        compatible = "zmk,input-processor-pointer-speed";
        #input-processor-cells = <2>;
        track-remainders;
        pointer-curve = "adaptive";
        pointer-curve-deadzone = <2>;
        pointer-curve-accel-multiplier = <1>;
        pointer-curve-accel-divisor = <12>;
        pointer-curve-max-delta = <120>;
        one-x-multiplier = <1>;
        one-x-divisor = <1>;
        min-percent = <10>;
        max-percent = <400>;
        initial-speed-position = <50>;
    };

    drag_scroll_processor: drag_scroll_processor {
        compatible = "zmk,input-processor-drag-scroll";
        #input-processor-cells = <2>;
        track-remainders;
        native-wheel-axis = "horizontal-when-enabled";
        scroll-min-step = <1>;
        one-x-multiplier = <1>;
        one-x-divisor = <1>;
        min-percent = <10>;
        max-percent = <1000>;
        initial-speed-position = <50>;
    };

    behaviors {
        drgscrl: drag_scroll {
            compatible = "zmk,behavior-drag-scroll";
            #binding-cells = <0>;
        };

        ptr_spd: pointing_speed {
            compatible = "zmk,behavior-pointing-speed";
            #binding-cells = <2>;
        };

        enc_ptr_spd: encoder_pointer_speed {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings =
                <&ptr_spd SPEED_POINTER SPEED_PREV>,
                <&ptr_spd SPEED_POINTER SPEED_NEXT>;
        };

        enc_scrl_spd: encoder_scroll_speed {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings =
                <&ptr_spd SPEED_SCROLL SPEED_PREV>,
                <&ptr_spd SPEED_SCROLL SPEED_NEXT>;
        };

        crq_mode: crqm {
            compatible = "zmk,behavior-cirque-mode";
            #binding-cells = <1>;
        };

        sel_x: select_x {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&mkp>, <&kp>;
        };

        ds_z: drag_scroll_z {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&drgscrl>, <&kp>;
        };

        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        mmv {
            acceleration-exponent = <1>;// 1
            time-to-max-speed-ms = <300>;// 40
            delay-ms = <0>;// 0
        };

        msc {
            acceleration-exponent = <0>;// 0
            time-to-max-speed-ms = <40>;// 500
            delay-ms = <0>;// 10
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <25 15>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <16 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEF";
            bindings = <
&kp Q        &kp W       &kp E       &kp R            &kp T      &kp Y        &kp U         &kp I           &kp O       &kp P
&ht LCTRL A  &ht LALT S  &ht LGUI D  &ht LSHIFT F     &kp G      &kp H        &ht RSHIFT J  &ht RGUI K      &ht RALT L  &ht RCTRL SINGLE_QUOTE
&kp Z        &kp X       &kp C       &kp V            &kp B      &kp N        &kp M         &kp COMMA       &kp DOT     &kp SLASH
                         &kp C_MUTE  &lt 1 BACKSPACE  &lt 2 TAB  &lt 2 ENTER  &lt 1 SPACE   &studio_unlock
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
        };

        symbols {
            display-name = "SYM";
            bindings = <
&kp EXCL        &kp AT           &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS     &kp PIPE       &kp PLUS   &kp N7        &kp N8          &kp N9        &kp STAR
&ht LCTRL HASH  &ht LALT DOLLAR  &ht LGUI LEFT_BRACKET  &ht LSHIFT RIGHT_BRACKET  &kp AMPERSAND  &kp EQUAL  &kp NUMBER_4  &kp N5          &kp NUMBER_6  &kp SEMI
&kp PERCENT     &kp CARET        &kp LEFT_BRACE         &kp RIGHT_BRACE           &kp TILDE      &kp MINUS  &kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3  &kp SLASH
                                 &kp C_MUTE             &kp BACKSLASH             &kp GRAVE      &kp DOT    &kp N0        &studio_unlock
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
        };

        navigation {
            display-name = "navigation";
            bindings = <
&none             &none            &none                  &none              &none   &none     &none      &none           &none      &none
&ht LCTRL ESCAPE  &ht LALT K_PREV  &ht LGUI K_PLAY_PAUSE  &ht LSHIFT K_NEXT  &none   &kp LEFT  &kp DOWN   &kp UP          &kp RIGHT  &none
&none             &none            &none                  &none              &none   &kp HOME  &kp PG_DN  &kp PG_UP       &kp END    &none
                                   &kp C_MUTE             &trans             &trans  &trans    &trans     &studio_unlock
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_BRI_DEC C_BRI_UP>;
        };

        #if defined(NXTKB_CODEX_MICRO)
#

        endif
    };
};
